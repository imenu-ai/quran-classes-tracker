{
  "name": "@qct/core",
  "version": "0.1.0",
  "private": true,
  "description": "React-free code shared by the web and mobile apps: domain rules, schemas, the sync protocol and the messages.",
  "type": "module",
  "exports": {
    "./domain/quran": "./src/domain/quran/index.ts",
    "./shared/schemas": "./src/shared/schemas/index.ts",
    "./messages/*": "./messages/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "use-intl": "^4.14.9",
    "vitest": "^5.0.3"
  }
}
