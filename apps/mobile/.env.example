# Copy to .env.local (not committed). Restart Metro after a change: it's
# inlined into the JavaScript bundle.

# The web app the mobile app talks to (sign-in, /api/me, sync), without a
# trailing slash. In development, a web server on this PC:
#   Android emulator: http://localhost:<port> after `adb reverse tcp:<port> tcp:<port>`
#   iPhone on the same Wi-Fi: http://<this PC's LAN IP>:<port>
# Release builds set it per profile in eas.json.
EXPO_PUBLIC_API_URL=http://localhost:3000
