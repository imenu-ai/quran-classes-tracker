{
  "name": "quran-classes-tracker",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qct/web dev",
    "build": "pnpm --filter @qct/web build",
    "start": "pnpm --filter @qct/web start",
    "mobile": "pnpm --filter @qct/mobile start",
    "mobile:android": "pnpm --filter @qct/mobile android",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @qct/web test:e2e",
    "db:indexes": "pnpm --filter @qct/web db:indexes",
    "center:create": "pnpm --filter @qct/web center:create",
    "dev:seed": "pnpm --filter @qct/web dev:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
