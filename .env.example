# Copy to .env.local and fill in. Never commit real secrets.

# MongoDB: local server for development, Atlas in production.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=quran_tracker

# Better Auth: a random secret of 32+ characters (e.g. `openssl rand -base64 32`)
# and the public URL the app is served from.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-value
BETTER_AUTH_URL=http://localhost:3000

# Locales users can use (comma-separated). Arabic only at launch; the
# English messages exist but stay hidden until "en" is added here.
ENABLED_LOCALES=ar
